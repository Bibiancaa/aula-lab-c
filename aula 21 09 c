#include <stdio.h>
int main()
{
    float tc, tf;
    int n, i;

    printf("Quantras temperaturas quer converter: ");
    scanf("%d", &n);

    tf = (tc*9/5) + 32;
    i=0;

    while (i<n)
    {
        printf("Digite a temperatura em Celsius: ");
        scanf("%f", &tc);
        tf = (tc*9/5) + 32;
        i++;
        printf("A temperura de %.1f é %.1f Fahrenheit.\n", tc, tf);
    }
    
}
